# Local PGlite is used when DATABASE_URL is unset.
PGLITE_DATA_DIR=./data/beloved-grants
DATABASE_URL=

# Auth.js GitHub OAuth
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_EMAILS=operator@example.com

# OpenAI administration
OPENAI_ADMIN_KEY=
OPENAI_MODE=fake
OPENAI_SMOKE_MODEL=gpt-5-nano
RUN_OPENAI_INTEGRATION=0

# Public origin (links, OAuth base, mail From host). Local default port 3002.
APP_URL=http://localhost:3002

# Transactional email (Resend). From is derived in code from APP_URL + grants@.
# Local / missing key → fake outbox. Force with EMAIL_MODE=fake|live.
RESEND_API_KEY=
EMAIL_MODE=
