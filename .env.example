# Local PGlite is used when DATABASE_URL is unset.
PGLITE_DATA_DIR=./data/beloved-grants
DATABASE_URL=

# Auth.js GitHub OAuth
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_EMAILS=operator@example.com

# OpenAI administration
OPENAI_ADMIN_KEY=
OPENAI_MODE=fake
OPENAI_SMOKE_MODEL=gpt-5-nano
RUN_OPENAI_INTEGRATION=0

# Public URL used when creating invite links.
APP_URL=http://localhost:3002
