# Local PGlite is used when DATABASE_URL is unset.
PGLITE_DATA_DIR=./data/beloved-grants
DATABASE_URL=

# Auth.js GitHub OAuth (client ID + admin emails are hardcoded in source)
AUTH_SECRET=
AUTH_GITHUB_SECRET=

# Non-production only: AUTH_TEST_BYPASS=1 treats AUTH_TEST_EMAIL as admin.
# MCP_TEST_TOKEN (optional) is accepted as a Bearer token when bypass is on.
AUTH_TEST_BYPASS=
AUTH_TEST_EMAIL=
MCP_TEST_TOKEN=

# OpenAI administration
OPENAI_ADMIN_KEY=
OPENAI_MODE=fake
OPENAI_SMOKE_MODEL=gpt-5-nano
RUN_OPENAI_INTEGRATION=0

# Public origin (links, OAuth base, mail From host). Local default port 3002.
APP_URL=http://localhost:3002

# Resend API secret. From address and fake/live mode are derived in code
# (grants@{APP_URL host}; fake when key missing or APP_URL is local).
RESEND_API_KEY=
